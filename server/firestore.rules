rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validUser() {
      return request.resource.data.keys().hasOnly(['displayName', 'photo', 'phone', 'online', 'latitude', 'longitude'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && (request.resource.data.photo == null || request.resource.data.photo is string)
        && request.resource.data.phone is number
        && request.resource.data.online is bool
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180;
    }

    // Everyone signed in can see the other users on the map; only the owner writes its document.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && validUser();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
